      "subtext": "\u0641\u0631\u064a\u0642\u0646\u0627 \u0645\u062a\u0627\u062d \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u062c\u0644\u0648\u0633 \u0648\u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0648\u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0639\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0642\u0628\u0644 \u0628\u062f\u0621 \u0627\u0644\u0644\u064a\u0644\u0629.",
      "nameLabel": "\u0627\u0644\u0627\u0633\u0645",
      "emailLabel": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a",
      "namePlaceholder": "\u0627\u0633\u0645\u0643",
