      {
        "title": "\u0627\u0644\u0632\u064a\u0651 \u0627\u0644\u0631\u0633\u0645\u064a",
        "body": "\u064a\u064f\u0637\u0644\u0628 \u0627\u0644\u0632\u064a\u0651 \u0627\u0644\u0631\u0633\u0645\u064a \u0645\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0636\u064a\u0648\u0641. \u062a\u062d\u062a\u0641\u0638 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0646\u0638\u0651\u0645\u0629 \u0628\u062d\u0642 \u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0639\u0646\u062f \u0627\u0644\u0645\u062f\u062e\u0644 \u0648\u0641\u0642\u064b\u0627 \u0644\u062a\u0648\u062c\u064a\u0647\u0627\u062a \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629."
      },
      {
        "title": "\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062a\u0630\u0627\u0643\u0631",
        "body": "\u064a\u0645\u0643\u0646 \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062a\u0630\u0627\u0643\u0631 \u0625\u0644\u0649 \u062d\u0627\u0636\u0631 \u0622\u062e\u0631 \u0645\u0646 \u062e\u0644\u0627\u0644 \u062a\u062d\u062f\u064a\u062b \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0627\u0636\u0631 \u0641\u064a \u062d\u0633\u0627\u0628\u0643 \u0642\u0628\u0644 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629."
      },
      {
        "title": "\u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629",
        "body": "\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0627\u0644\u0645\u062c\u0645\u0651\u0639\u0629 \u0639\u0646\u062f \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0644\u0623\u0647\u062f\u0627\u0641 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0641\u0642\u0637\u060c \u0648\u064a\u064f\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647\u0627 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627 \u0644\u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
      },
      {
        "title": "\u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0648\u0627\u0644\u062a\u0633\u062c\u064a\u0644",
        "body": "\u0633\u064a\u064f\u062c\u0631\u0649 \u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0648\u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u0631\u0626\u064a \u0637\u0648\u0627\u0644 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0629 \u0644\u0623\u0647\u062f\u0627\u0641 \u062a\u062d\u0631\u064a\u0631\u064a\u0629 \u0648\u062a\u0631\u0648\u064a\u062c\u064a\u0629. \u0628\u0627\u0644\u062d\u0636\u0648\u0631\u060c \u064a\u0648\u0627\u0641\u0642 \u0627\u0644\u0636\u064a\u0648\u0641 \u0639\u0644\u0649 \u0627\u0645\u0643\u0627\u0646\u064a\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0635\u0648\u0631\u0647\u0645 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0648\u0627\u062f."
      },
      {
        "title": "\u0627\u0644\u0625\u0644\u0679\u0627\u0621 \u0648\u0627\u0644\u0627\u0633\u0679\u0631\u062f\u0627\u062f",
        "body": "\u064a\u064f\u0646\u0638\u0631 \u0641\u064a \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0625\u0644\u0679\u0627\u0621 \u0648\u0627\u0644\u0627\u0633\u0679\u0631\u062f\u0627\u062f \u0644\u0643\u0644 \u062d\u0627\u0644\u0629 \u0639\u0644\u0649 \u062d\u062f\u0629. \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0641\u0631\u064a\u0642 \u0627\u0644\u0641\u0639\u0627\u0644\u064a\u0627\u062a \u0641\u064a \u0623\u0642\u0631\u0628 \u0648\u0642\u062a \u0645\u0645\u0643\u0646 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629."
      }
    ]
  },
