# Use standard mongodb:// URI from Atlas (Connect > Drivers > "Standard connection string")
# mongodb+srv:// fails on some Windows networks with querySrv ECONNREFUSED
MONGODB_URI=mongodb://<username>:<password>@ac-bpzg8rn-shard-00-00.w4h5xms.mongodb.net:27017,ac-bpzg8rn-shard-00-01.w4h5xms.mongodb.net:27017,ac-bpzg8rn-shard-00-02.w4h5xms.mongodb.net:27017/?ssl=true&authSource=admin&replicaSet=atlas-je4iqa-shard-0&retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=registration_data
MONGODB_COLLECTION=form
MONGODB_STAFF_COLLECTION=staff_registration

# GTCFX IB Performance API (values from Postman)
IB_TOKEN_URL=http://dataportal.gtcfx.group/gtcfxbi/api/oauth2/getToken
IB_REGISTRATION_URL=http://dataportal.gtcfx.group/gtcfxbi/GTC_ana/app/dataApi/clientRegistrarion.app/API/queryData.afl
IB_PERFORMANCE_URL=http://dataportal.gtcfx.group/gtcfx/GTC_ana/app/dataApi/emailPerformanceQuery2026.app/API/queryData.afl
IB_APP_ID=
IB_APP_SECRET=
IB_USERID=marketing

# Secret used to hash OTP codes server-side (required in production)
OTP_SECRET=your-long-random-otp-secret

# AWS S3 — passport uploads (gtcfx-bucket / falcon-document/)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=gtcfx-bucket
AWS_S3_PASSPORT_PREFIX=falcon-document
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional public site URL for email status links
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Admin portal login (change in production)
ADMIN_EMAIL=admin@gtcfx.com
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=your-long-random-admin-session-secret
